# Copy values into your deployment secret manager. Never commit real secrets.
# On Vercel, use encrypted/sensitive environment variables.
CFA_ACCESS_PASSWORD=replace-with-a-random-password-at-least-16-characters
CFA_SESSION_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters

# Set one of these to a dedicated PostgreSQL database connection string.
# Use a pooled connection string and SSL for hosted PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# CFA_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Google Gemini Flash; key stays on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CFA_PRIVACY_NOTICE_URL=https://example.com/privacy

# Optional OpenAI-compatible provider; used only when Gemini is not configured.
CFA_MODEL_BASE_URL=https://api.openai.com/v1
CFA_MODEL_API_KEY=
CFA_MODEL_NAME=

# Local SQLite fallback for development only. Not durable on Vercel.
CFA_DATABASE_PATH=./data/cfa.db
