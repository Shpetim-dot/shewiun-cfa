{
  "id": "agent-launch",
  "version": "1.0.0",
  "title": "Agent Launch Review",
  "disclaimer": "This is a structured self-assessment based on your answers. It is not a security test, audit, or certification. Do not enter secrets, API keys, or customer data.",
  "steps": [
    {
      "id": "purpose",
      "title": "Purpose and context",
      "description": "Define the agent, who uses it, and where it will run.",
      "fields": [
        {
          "id": "purpose",
          "label": "What does the agent do?",
          "type": "textarea",
          "required": true,
          "maxLength": 2000
        },
        {
          "id": "user_group",
          "label": "Who will use or be affected by it?",
          "type": "text",
          "required": true,
          "maxLength": 500
        },
        {
          "id": "volume",
          "label": "Expected usage volume",
          "type": "select",
          "required": true,
          "options": [
            "Low (under 100 actions/day)",
            "Medium (100–10,000 actions/day)",
            "High (over 10,000 actions/day)",
            "Unknown"
          ]
        },
        {
          "id": "jurisdictions",
          "label": "Jurisdictions",
          "type": "multiselect",
          "required": true,
          "options": [
            "EU",
            "UK",
            "US",
            "Other",
            "Unknown"
          ]
        },
        {
          "id": "environment",
          "label": "Deployment environment",
          "type": "radio",
          "required": true,
          "options": [
            "Pilot",
            "Production",
            "Internal prototype"
          ]
        }
      ]
    },
    {
      "id": "tools",
      "title": "Tools and permissions",
      "description": "List APIs and tools the agent can call. Add one row per tool.",
      "fields": [
        {
          "id": "tools",
          "label": "Tools and APIs",
          "type": "tool-list",
          "required": true,
          "help": "For each tool, describe read/write access, scope, credential type, and spending or amount limits."
        }
      ]
    },
    {
      "id": "actions",
      "title": "Business actions",
      "description": "Select actions the agent could perform, directly or through tools.",
      "fields": [
        {
          "id": "business_actions",
          "label": "Possible actions",
          "type": "multiselect",
          "required": true,
          "options": [
            "Payments",
            "Refunds",
            "Account or limit changes",
            "Data export",
            "Messages to customers",
            "Other external write action",
            "No external or irreversible actions"
          ]
        }
      ]
    },
    {
      "id": "controls",
      "title": "Controls today",
      "description": "Select controls that are already implemented, not merely planned.",
      "fields": [
        {
          "id": "controls",
          "label": "Implemented controls",
          "type": "multiselect",
          "required": true,
          "options": [
            "Human approval before consequential actions",
            "Rate or amount limits",
            "Tool/API allowlists",
            "Agent identity separate from user identity",
            "Kill switch",
            "Audit logging",
            "Monitoring and alerts",
            "Named incident response owner",
            "None of these",
            "Unknown"
          ]
        }
      ]
    },
    {
      "id": "inputs",
      "title": "Inputs and trust boundaries",
      "description": "Consider untrusted content and how it could influence actions.",
      "fields": [
        {
          "id": "untrusted_inputs",
          "label": "Untrusted inputs reaching the agent",
          "type": "multiselect",
          "required": true,
          "options": [
            "Emails",
            "Web content",
            "Tickets",
            "Documents",
            "Tool/API outputs",
            "User prompts",
            "None",
            "Unknown"
          ]
        },
        {
          "id": "prompt_injection_mitigations",
          "label": "Prompt-injection mitigations",
          "type": "textarea",
          "required": false,
          "maxLength": 1500
        },
        {
          "id": "isolation",
          "label": "Are untrusted inputs isolated from tool instructions and permissions?",
          "type": "radio",
          "required": true,
          "options": [
            "Yes",
            "Partially",
            "No",
            "Unknown"
          ]
        },
        {
          "id": "multi_agent_chaining",
          "label": "Does the system chain multiple agents or tools?",
          "type": "radio",
          "required": true,
          "options": [
            "Yes",
            "No",
            "Unknown"
          ]
        }
      ]
    },
    {
      "id": "decision_context",
      "title": "Launch decision",
      "description": "Capture ownership, timing, and unresolved concerns.",
      "fields": [
        {
          "id": "planned_launch",
          "label": "Planned launch date",
          "type": "date",
          "required": false
        },
        {
          "id": "approver",
          "label": "Who owns the launch decision?",
          "type": "text",
          "required": true,
          "maxLength": 300
        },
        {
          "id": "failure_cost",
          "label": "What could failure cost?",
          "type": "select",
          "required": true,
          "options": [
            "Low / easily reversible",
            "Moderate business impact",
            "High financial, customer, or operational impact",
            "Unknown"
          ]
        },
        {
          "id": "concerns",
          "label": "Open concerns",
          "type": "textarea",
          "required": false,
          "maxLength": 2000
        }
      ]
    }
  ]
}
