@@ -0,0 +1,37 @@
+:root{--bg:#fafaf8;--surface:#fff;--ink:#1c1c1a;--muted:#6b6a66;--line:#e6e4de;--accent:#2f6bff;--accent-ink:#fff;--crit:#b42318;--high:#b54708;--med:#8a6d00;--low:#52525b;--r:10px}
+@media (prefers-color-scheme:dark){:root{--bg:#1a1a18;--surface:#222220;--ink:#ecebe7;--muted:#9a9993;--line:#333330;--accent:#6b97ff;--accent-ink:#0d0d0c;--crit:#f97066;--high:#fdb022;--med:#fec84b;--low:#a1a1aa}}
+*{box-sizing:border-box}
+body.al{margin:0;font:15px/1.5 ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);background:var(--bg);min-height:100vh}
+.al-wrap{max-width:680px;margin:0 auto;padding:48px 20px 96px}
+.al-head{display:flex;align-items:center;gap:12px;margin-bottom:8px}
+.al-head h1{font-size:22px;font-weight:600;margin:0;letter-spacing:-.01em}
+.al-sub{color:var(--muted);margin:0 0 32px;max-width:60ch}
+.al-steps{display:flex;gap:6px;margin-bottom:28px}
+.al-steps button{flex:1;border:0;border-top:2px solid var(--line);background:none;padding:8px 0 0;text-align:left;font:inherit;font-size:13px;color:var(--muted);cursor:pointer}
+.al-steps button[aria-current=step]{border-color:var(--accent);color:var(--ink)}
+.al-q{margin:0 0 28px;padding:0;border:0}
+.al-q legend,.al-q>label{font-weight:500;margin-bottom:10px;display:block;padding:0}
+.al-hint{color:var(--muted);font-size:13px;margin:-4px 0 8px}
+.al-opts{display:flex;flex-wrap:wrap;gap:8px}
+.al-opt{position:relative}
+.al-opt input{position:absolute;opacity:0;inset:0;cursor:pointer;margin:0}
+.al-opt span{display:block;padding:8px 14px;border:1px solid var(--line);border-radius:var(--r);background:var(--surface);transition:border-color .15s}
+.al-opt input:checked+span{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}
+.al-opt input:focus-visible+span{outline:2px solid var(--accent);outline-offset:2px}
+textarea{width:100%;min-height:84px;padding:10px 12px;border:1px solid var(--line);border-radius:var(--r);background:var(--surface);color:inherit;font:inherit;resize:vertical}
+textarea:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
+.al-nav{display:flex;justify-content:space-between;margin-top:8px}
+.al-btn{padding:9px 18px;border-radius:var(--r);border:1px solid var(--line);background:var(--surface);color:inherit;font:inherit;cursor:pointer}
+.al-btn.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);font-weight:500}
+.al-btn:disabled{opacity:.5;cursor:not-allowed}
+.al-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+.al-warn{color:var(--crit);font-size:13px;margin:6px 0 0}
+.al-verdict{font-size:26px;font-weight:600;margin:0 0 4px;letter-spacing:-.01em}
+.al-disc{color:var(--muted);font-size:13px;border-left:2px solid var(--line);padding-left:12px;margin:16px 0 28px}
+.al-f{border-top:1px solid var(--line);padding:16px 0}
+.al-f h3{font-size:15px;margin:0 0 4px;font-weight:600}
+.al-f p{margin:2px 0;color:var(--muted)}
+.al-sev{font-size:13px;font-weight:600;margin-right:8px}
+.al-sev.critical{color:var(--crit)}.al-sev.high{color:var(--high)}.al-sev.medium{color:var(--med)}.al-sev.low{color:var(--low)}
+.al-assumed{font-size:12px;font-weight:400;color:var(--muted);border:1px solid var(--line);border-radius:6px;padding:1px 6px;margin-left:6px}
+@media (prefers-reduced-motion:reduce){.al-opt span{transition:none}}
